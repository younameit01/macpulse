# MacAI Storage Observatory Configuration
# Coordinator & Ingestion
MACAI_COORDINATOR_URL=http://localhost:8000
MACAI_AGENT_NAME=Mac-Primary
MACAI_SAMPLE_INTERVAL_SECONDS=3
MACAI_ENABLE_ELEVATED_COLLECTOR=false

# Gemini Explain Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Persistence
MACAI_DB_PATH=macai_observatory.db

# Demo Workload Configuration
MACAI_DEMO_DIR=/tmp/macai_demo
